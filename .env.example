# Crawl4AI Service settings
CRAWL4AI_SERVICE_URL="http://localhost:8000"
CRAWL4AI_CONCURRENCY="2"

OPENAI_KEY="YOUR_KEY"
CONTEXT_SIZE="128000"

# If you want to use other OpenAI compatible API, add the following below:
# OPENAI_ENDPOINT="http://localhost:11434/v1"
# CUSTOM_MODEL="llama3.1"

# If you want to use fireworks.ai's DeepSeek R1 model:
# FIREWORKS_KEY="YOUR_KEY"

# PubMed API settings
# PUBMED_API_KEY="YOUR_PUBMED_API_KEY"
# INCLUDE_PUBMED_SEARCH=true
# USE_MESH_TERMS=true
# MESH_RESTRICTIVENESS="medium" # Options: "low", "medium", "high"

# Citation format for PubMed articles
# CITATION_STYLE="NLM" # or "mla", "chicago", etc.
